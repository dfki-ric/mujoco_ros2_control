<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<!-- Format 3 rather than 2 because of <member_of_group>, which srv/ needs. -->
<package format="3">
  <name>mujoco_ros2_control_examples</name>
  <version>1.0.0</version>
  <description>
    Example robots simulated with mujoco_ros2_control: Franka (with the task
    table), Universal Robots (UR) and Unitree H1.
  </description>

  <maintainer email="adrian.danzglock@dfki.de">Adrian Danzglock</maintainer>

  <license>BSD-3-Clause</license>
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Common runtime dependencies -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <depend>mujoco_ros2_control</depend>

  <!-- For the example plugins in src/: TouchGridSensor and BodyServices. -->
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>realtime_tools</depend>
  <depend>std_msgs</depend>

  <!-- BodyServices brings its own service definitions (srv/), so this package
       generates interfaces as well as consuming them. -->
  <depend>geometry_msgs</depend>
  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <exec_depend>urdf</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <!-- Controllers used by the examples -->
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>force_torque_sensor_broadcaster</exec_depend>
  <exec_depend>imu_sensor_broadcaster</exec_depend>
  <exec_depend>pose_broadcaster</exec_depend>
  <exec_depend>position_controllers</exec_depend>

  <!-- Robot descriptions (Franka and UR are pulled from these packages) -->
  <exec_depend>franka_description</exec_depend>
  <exec_depend>realsense2_description</exec_depend>
  <exec_depend>ur_description</exec_depend>

  <!-- Tests -->
  <test_depend>ament_cmake_ros</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>launch_testing_ros</test_depend>
  <!-- The ur_multi test queries the controller manager for its hardware components. -->
  <test_depend>controller_manager_msgs</test_depend>
  <!-- The body services test calls /mujoco_reset. -->
  <test_depend>std_srvs</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
