<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="imrk_table">
  <xacro:arg name="prefix" default="imrk_"/>
  <xacro:arg name="table_xyz" default="0 0 0"/>
  <xacro:arg name="table_rpy" default="0 0 0"/>

  <material name="IMRKTableGrey">
    <color rgba="0.4 0.4 0.4 1.0"/>
  </material>

  <link name="world"/>

  <joint name="$(arg prefix)table_world_joint" type="fixed">
    <parent link="world"/>
    <child link="$(arg prefix)table"/>
    <origin xyz="$(arg table_xyz)" rpy="$(arg table_rpy)"/>
  </joint>

  <link name="$(arg prefix)table">
    <visual name="$(arg prefix)table_visual">
      <origin xyz="0 0 0" rpy="0 0 -1.570796327"/>
      <geometry>
        <mesh filename="file://$(find mujoco_ros2_control_examples)/meshes/imrk_table/table.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="IMRKTableGrey"/>
    </visual>
    <collision name="$(arg prefix)table_collision">
      <origin xyz="0 0 0" rpy="0 0 -1.570796327"/>
      <geometry>
        <mesh filename="file://$(find mujoco_ros2_control_examples)/meshes/imrk_table/table.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.012661 -0.005935 0.454" rpy="0 0 0"/>
      <mass value="200.0"/>
      <inertia ixx="22.711037" ixy="0" ixz="0" iyy="36.177105" iyz="0" izz="32.632935"/>
    </inertial>
  </link>

  <mujoco>
    <reference name="$(arg prefix)table">
      <geom friction="0.8 0.02 0.01" solimp="0.95 0.99 0.001" solref="0.004 1" priority="1"/>
    </reference>
  </mujoco>
</robot>
