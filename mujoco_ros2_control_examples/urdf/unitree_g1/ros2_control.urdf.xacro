<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- low_level:=true hands the joints to the UnitreeHgLowLevel plugin, which
       closes the motor PD loop into qfrc_applied itself. The command interfaces
       then have to go: whatever claims them writes the same field, so leaving
       them in would have two writers per step. The state interfaces stay, and
       with them the start pose and every broadcaster. -->
  <xacro:macro name="unitree_g1_ros2_control" params="mujoco:=true low_level:=false">
    <ros2_control name="Unitree_G1_HardwareInterface" type="system">
      <hardware>
        <plugin>mujoco_ros2_control/MujocoSystem</plugin>
      </hardware>

      <!-- One actuated joint: PD hold via kp/kd, target = default pose. -->
      <xacro:macro name="g1_joint" params="name kp kd initial_position:=0.0">
        <joint name="${name}">
          <xacro:unless value="${low_level}">
            <command_interface name="position">
              <param name="initial_value">${initial_position}</param>
            </command_interface>
            <param name="kp">${kp}</param>
            <param name="kd">${kd}</param>
          </xacro:unless>
          <state_interface name="position">
            <param name="initial_value">${initial_position}</param>
          </state_interface>
          <state_interface name="velocity">
            <param name="initial_value">0.0</param>
          </state_interface>
          <state_interface name="effort"/>
        </joint>
      </xacro:macro>

      <!-- Legs (kp = base*5.0: hip 500, knee 750, ankle 200) -->
      <xacro:g1_joint name="left_hip_pitch_joint"    kp="500" kd="2" initial_position="-0.1"/>
      <xacro:g1_joint name="left_hip_roll_joint"     kp="500" kd="2" initial_position="0.0"/>
      <xacro:g1_joint name="left_hip_yaw_joint"      kp="500" kd="2" initial_position="0.0"/>
      <xacro:g1_joint name="left_knee_joint"         kp="750" kd="4" initial_position="0.3"/>
      <xacro:g1_joint name="left_ankle_pitch_joint"  kp="200" kd="2" initial_position="-0.2"/>
      <xacro:g1_joint name="left_ankle_roll_joint"   kp="200" kd="2" initial_position="0.0"/>
      <xacro:g1_joint name="right_hip_pitch_joint"   kp="500" kd="2" initial_position="-0.1"/>
      <xacro:g1_joint name="right_hip_roll_joint"    kp="500" kd="2" initial_position="0.0"/>
      <xacro:g1_joint name="right_hip_yaw_joint"     kp="500" kd="2" initial_position="0.0"/>
      <xacro:g1_joint name="right_knee_joint"        kp="750" kd="4" initial_position="0.3"/>
      <xacro:g1_joint name="right_ankle_pitch_joint" kp="200" kd="2" initial_position="-0.2"/>
      <xacro:g1_joint name="right_ankle_roll_joint"  kp="200" kd="2" initial_position="0.0"/>

      <!-- Waist (kp = base*5.0: yaw 1000, roll/pitch 200) -->
      <xacro:g1_joint name="waist_yaw_joint"   kp="1000" kd="5" initial_position="0.0"/>
      <xacro:g1_joint name="waist_roll_joint"  kp="200"  kd="5" initial_position="0.0"/>
      <xacro:g1_joint name="waist_pitch_joint" kp="200"  kd="5" initial_position="0.0"/>

      <!-- Left arm (kp = base*5.0: 200) -->
      <xacro:g1_joint name="left_shoulder_pitch_joint" kp="200" kd="1" initial_position="0.3"/>
      <xacro:g1_joint name="left_shoulder_roll_joint"  kp="200" kd="1" initial_position="0.25"/>
      <xacro:g1_joint name="left_shoulder_yaw_joint"   kp="200" kd="1" initial_position="0.0"/>
      <xacro:g1_joint name="left_elbow_joint"          kp="200" kd="1" initial_position="0.97"/>
      <xacro:g1_joint name="left_wrist_roll_joint"     kp="200" kd="1" initial_position="0.15"/>
      <xacro:g1_joint name="left_wrist_pitch_joint"    kp="200" kd="1" initial_position="0.0"/>
      <xacro:g1_joint name="left_wrist_yaw_joint"      kp="200" kd="1" initial_position="0.0"/>

      <!-- Right arm (kp = base*5.0: 200) -->
      <xacro:g1_joint name="right_shoulder_pitch_joint" kp="200" kd="1" initial_position="0.3"/>
      <xacro:g1_joint name="right_shoulder_roll_joint"  kp="200" kd="1" initial_position="-0.25"/>
      <xacro:g1_joint name="right_shoulder_yaw_joint"   kp="200" kd="1" initial_position="0.0"/>
      <xacro:g1_joint name="right_elbow_joint"          kp="200" kd="1" initial_position="0.97"/>
      <xacro:g1_joint name="right_wrist_roll_joint"     kp="200" kd="1" initial_position="-0.15"/>
      <xacro:g1_joint name="right_wrist_pitch_joint"    kp="200" kd="1" initial_position="0.0"/>
      <xacro:g1_joint name="right_wrist_yaw_joint"      kp="200" kd="1" initial_position="0.0"/>

      <!-- IMU on the pelvis (matches the mujoco <sensor> block in the main xacro) -->
      <sensor name="imu_in_pelvis">
        <param name="plugin">mujoco_ros2_control/ImuSensor</param>
        <param name="site">imu_in_pelvis</param>
        <state_interface name="orientation.x"/>
        <state_interface name="orientation.y"/>
        <state_interface name="orientation.z"/>
        <state_interface name="orientation.w"/>
        <state_interface name="angular_velocity.x"/>
        <state_interface name="angular_velocity.y"/>
        <state_interface name="angular_velocity.z"/>
        <state_interface name="linear_acceleration.x"/>
        <state_interface name="linear_acceleration.y"/>
        <state_interface name="linear_acceleration.z"/>
      </sensor>

      <!-- Floating-base pose of the pelvis (for odom / tf) -->
      <sensor name="pelvis_pose">
        <param name="plugin">mujoco_ros2_control/PoseSensor</param>
        <param name="site">pelvis</param>
        <state_interface name="position.x"/>
        <state_interface name="position.y"/>
        <state_interface name="position.z"/>
        <state_interface name="orientation.x"/>
        <state_interface name="orientation.y"/>
        <state_interface name="orientation.z"/>
        <state_interface name="orientation.w"/>
      </sensor>
    </ros2_control>
  </xacro:macro>
</robot>