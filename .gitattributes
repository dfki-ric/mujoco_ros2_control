# Mesh assets are binary and large; keep them out of the git object store.
# Fetching them needs git-lfs installed (`git lfs install`), and CI checkouts
# must set `lfs: true` or the working tree gets pointer files instead of meshes.
*.stl filter=lfs diff=lfs merge=lfs -text
*.STL filter=lfs diff=lfs merge=lfs -text
*.obj filter=lfs diff=lfs merge=lfs -text
*.dae filter=lfs diff=lfs merge=lfs -text
*.msh filter=lfs diff=lfs merge=lfs -text
